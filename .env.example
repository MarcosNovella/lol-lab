# Riot API key. Get one at https://developer.riotgames.com (login with your Riot account,
# then "Regenerate API Key" on the dashboard).
#
# Development keys EXPIRE EVERY 24 HOURS. When calls start failing with 401/403, come back
# here, paste a fresh key, and keep working — the server re-reads this file on every request,
# so there is nothing to restart.
#
# Apply for a Personal API Key ("Register Product" on the same portal) to stop rotating:
# same rate limit, but it does not expire.
RIOT_API_KEY=

# Riot region. LAS (Latin America South) => la2 / americas.
RIOT_PLATFORM=la2
