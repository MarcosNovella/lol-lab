{
  "name": "riot-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP server over the Riot Games API for analysing League of Legends matches",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/server.ts",
    "verify": "biome check . --diagnostic-level=warn && tsc --noEmit && vitest run",
    "fix": "biome check --write .",
    "test": "vitest",
    "lol": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "smoke": "node --disable-warning=ExperimentalWarning scripts/smoke.ts",
    "call": "node --disable-warning=ExperimentalWarning scripts/call.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.9"
  }
}
